# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MULTI-KEY ROTATION (Optional, useful when deploying to Netlify to prevent 429 rate-limiting issues for multi-user)
# You can provide a comma-separated list of multiple API keys:
GEMINI_API_KEYS_POOL="key1,key2,key3"

# Or configure individual sequential keys:
GEMINI_API_KEY_2="MY_GEMINI_API_KEY_2"
GEMINI_API_KEY_3="MY_GEMINI_API_KEY_3"

# VITE_GEMINI_API_KEY: Optional client-side API Key for direct client-side Imagen generation
VITE_GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
